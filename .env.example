# A PostgreSQL connection string. Example: postgresql://user:password@localhost:5432/linkmarket
DATABASE_URL=
# A long random value used to sign the HttpOnly login session cookie.
AUTH_SECRET=
# Comma-separated hosts permitted for affiliate redirects (optional; empty permits any http(s) URL stored by an admin).
AFFILIATE_ALLOWED_HOSTS=
# Public origin used by sitemap generation. Example: https://linkmarket.example
NEXT_PUBLIC_APP_URL=http://localhost:3000
