# Database Connection
DATABASE_URL="postgresql://user:password@host:5432/linkmarket?sslmode=require"

# App & NextAuth Configuration
AUTH_SECRET="generate-a-32-byte-secret-using-openssl-rand-hex-32"
NEXTAUTH_SECRET="generate-a-32-byte-secret-using-openssl-rand-hex-32"
NEXTAUTH_URL="https://linkmarket-nine.vercel.app"

# Google OAuth Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Transactional Email Provider (Resend / SendGrid / SMTP)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="LinkMarket <noreply@yourdomain.com>"

# Affiliate & Public Origin Configuration
AFFILIATE_ALLOWED_HOSTS=
NEXT_PUBLIC_APP_URL="http://localhost:3000"
